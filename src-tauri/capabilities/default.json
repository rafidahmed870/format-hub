{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Capability for the main window",
  "windows": ["main"],
  "permissions": [
    "core:default",
    "opener:default",
    "dialog:default",
    "fs:default",
    "fs:allow-stat",
    "fs:allow-read-file",
    "fs:allow-read-dir",
    {
      "identifier": "fs:scope",
      "allow": [
        "$HOME/**/*",
        "$DESKTOP/**/*",
        "$DOCUMENT/**/*",
        "$DOWNLOAD/**/*",
        "$PICTURES/**/*",
        "$MUSIC/**/*",
        "$VIDEO/**/*",
        "$APPDATA/**/*",
        "$LOCALDATA/**/*"
      ],
      "deny": []
    },
    "shell:allow-spawn",
    "shell:allow-execute"
  ]
}
